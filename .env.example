SABNZBD_URL=http://localhost:8080
SABNZBD_API_KEY=replace-with-your-api-key
SABNZBD_DOWNLOAD_DIR=/absolute/path/to/downloads
DB_PATH=nzbunny.db
PORT=1337
RETENTION_TTL=15m
CLEANUP_INTERVAL=30s
POLL_INTERVAL=10s
SABNZBD_REQUEST_TIMEOUT=30s
HTTP_HEADER_TIMEOUT=15s
HTTP_REQUEST_TIMEOUT=5m
MAX_ARTIFACT_BYTES=209715200
MAX_UPLOAD_BYTES=2097152
MAX_ACTIVE_JOBS=32
MAX_CONNECTIONS=128
UPLOADS_PER_MINUTE=20
TRUSTED_PROXY_CIDRS=
